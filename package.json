{
  "name": "openapi-radar",
  "version": "1.0.0",
  "private": false,
  "description": "A GitHub Action that reports OpenAPI breaking changes on pull requests.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "ncc build src/index.ts -o dist --minify"
  },
  "dependencies": {
    "@actions/core": "2.0.3",
    "@actions/github": "8.0.1"
  },
  "devDependencies": {
    "@pb33f/openapi-changes": "0.2.11",
    "@types/node": "24.5.2",
    "@vercel/ncc": "0.38.4",
    "typescript": "5.9.2"
  }
}
